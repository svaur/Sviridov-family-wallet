# Copy to .env and adjust. Never commit real secrets.
POSTGRES_DB=sviridov_wallet
POSTGRES_USER=sviridov
POSTGRES_PASSWORD=change-me

# Optional: create the first user on startup (min 8 chars password).
# Leave blank to create users manually via SQL / CLI.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=change-me-too

# Optional: create the first admin-panel account (min 8 chars password).
# The admin must change this password on first login. Leave blank to skip.
ADMIN_USERNAME=root
ADMIN_PASSWORD=change-me-admin
